generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId              Int               @id @default(autoincrement()) @map("user_id")
  firstName           String            @map("first_name") @db.VarChar(75)
  lastName            String            @map("last_name") @db.VarChar(75)
  email               String            @unique @db.VarChar(150)
  passwordHash        String            @map("password_hash") @db.VarChar(255)
  phoneNumber         String?           @map("phone_number") @db.VarChar(30)
  role                String            @default("candidate") @db.VarChar(20)
  avatarUrl           String?           @map("avatar_url") @db.VarChar(500)
  targetExamId        Int?              @map("target_exam_id")
  targetSubject       String?           @map("target_subject") @db.VarChar(150)
  knowledgeLevel      String?           @map("knowledge_level") @db.VarChar(50)
  availableStudyHours Decimal?          @map("available_study_hours") @db.Decimal(5, 2)
  dailyGoalMinutes    Int               @default(30) @map("daily_goal_minutes")
  streakDays          Int               @default(0) @map("streak_days")
  completedQuestions  Int               @default(0) @map("completed_questions")
  averageScore        Decimal           @default(0) @map("average_score") @db.Decimal(5, 2)
  studyHoursTotal     Decimal           @default(0) @map("study_hours_total") @db.Decimal(7, 2)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)
  clerkId             String?           @unique @map("clerk_id")
  attempt             attempt[]
  mentor_booking      mentor_booking[]
  notification        notification[]
  progress_record     progress_record[]
  study_plan          study_plan[]
  exam                exam?             @relation(fields: [targetExamId], references: [exam_id], onUpdate: NoAction, map: "fk_users_target_exam")
  weak_area           weak_area[]

  @@index([targetExamId], map: "idx_users_target_exam")
  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model announcement {
  announcement_id Int            @id @default(autoincrement())
  exam_id         Int
  title           String         @db.VarChar(200)
  summary         String?
  content         String?
  publish_date    DateTime       @default(now()) @db.Timestamp(6)
  category        String?        @db.VarChar(50)
  is_urgent       Boolean        @default(false)
  attachments     Json?
  exam            exam           @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_announcement_exam")
  notification    notification[]

  @@index([exam_id], map: "idx_announcement_exam")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model answer_option {
  option_id      Int              @id @default(autoincrement())
  question_id    Int
  option_text    String
  is_correct     Boolean          @default(false)
  question       question         @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_option_question")
  attempt_answer attempt_answer[]

  @@unique([option_id, question_id], map: "uq_answer_option_question")
  @@index([question_id], map: "idx_answer_option_question")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attempt {
  attempt_id     Int              @id @default(autoincrement())
  user_id        Int
  attempt_type   String           @db.VarChar(20)
  quiz_id        Int?
  mock_exam_id   Int?
  score          Decimal?         @db.Decimal(6, 2)
  start_time     DateTime?        @db.Timestamp(6)
  end_time       DateTime?        @db.Timestamp(6)
  mock_exam      mock_exam?       @relation(fields: [mock_exam_id], references: [mock_exam_id], onUpdate: NoAction, map: "fk_attempt_mock_exam")
  quiz           quiz?            @relation(fields: [quiz_id], references: [quiz_id], onUpdate: NoAction, map: "fk_attempt_quiz")
  users          User             @relation(fields: [user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_user")
  attempt_answer attempt_answer[]

  @@index([mock_exam_id], map: "idx_attempt_mock_exam")
  @@index([quiz_id], map: "idx_attempt_quiz")
  @@index([user_id], map: "idx_attempt_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attempt_answer {
  answer_id          Int            @id @default(autoincrement())
  attempt_id         Int
  question_id        Int
  selected_option_id Int?
  is_correct         Boolean?
  attempt            attempt        @relation(fields: [attempt_id], references: [attempt_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_answer_attempt")
  answer_option      answer_option? @relation(fields: [selected_option_id], references: [option_id], onUpdate: NoAction, map: "fk_attempt_answer_option")
  question           question       @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_answer_question")

  @@unique([attempt_id, question_id], map: "uq_attempt_question")
  @@index([selected_option_id], map: "idx_attempt_answer_option")
  @@index([question_id], map: "idx_attempt_answer_question")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model exam {
  exam_id      Int            @id @default(autoincrement())
  exam_name    String         @db.VarChar(150)
  exam_type    String?        @db.VarChar(100)
  category     String?        @db.VarChar(50)
  target_code  String?        @db.VarChar(50)
  description  String?
  schedules    Json?
  requirements Json?
  announcement announcement[]
