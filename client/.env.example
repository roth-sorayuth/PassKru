# Clerk Authentication Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL (e.g. https://passkru-v1.up.railway.app/api)
VITE_API_URL=http://localhost:5000/api

# Admin Dashboard URL (Where admins get redirected when logging in or clicking Admin Dashboard)
# In production, set this to your hosted admin dashboard URL (e.g., https://admin.passkru.com or https://passkru-admin.vercel.app)
VITE_ADMIN_URL=http://localhost:3001

# Supabase Configurations
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
